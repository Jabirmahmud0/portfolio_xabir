DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Optional one-time DDL credential; omit from the deployed application.
MIGRATION_DATABASE_URL=postgresql://migration_user:password@host/database?sslmode=require
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=scrypt:replace-with-generated-hash
SESSION_SECRET=replace-with-at-least-32-random-characters

# Added during the final media phase
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
